# Ignore editor and IDE settings
.idea/
.vscode/
.cursor/
.specify/
.claude/
.cache/
.sync*

# Ignore log files
*.log
log/

# Ignore temporary files
tmp/
*.tar.gz
*.7z

# Ignore build and distribution directories
backup/
bin/
x-ui/
dist/
release/
node_modules/
.npm-cache/
.toolchain/

# Ignore compiled binaries
main

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
x-ui.db
x-ui.db-shm
x-ui.db-wal
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env

# Fork: track the built frontend so a plain `git clone` can build a working
# panel. Upstream ignores dist/ and assumes the developer runs `npm run build`,
# which is not viable on a small deployment VPS (no Node, low RAM).
!internal/web/dist/
